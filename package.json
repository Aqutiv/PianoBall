{
  "name": "pianoball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MIDI-controlled musical pinball",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "export:content": "node scripts/export-content.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "og": "node scripts/gen-og.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
